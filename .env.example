# ----- Server -----
# Cổng HOST mà shop-api được ánh xạ ra. Default: 8080
# Cổng ứng dụng lắng nghe bên trong container luôn cố định 8080 và không cấu
# hình được từ đây - compose ghim SERVER_PORT: 8080 vào container. Đừng đặt lại
# biến SERVER_PORT trong .env: Spring Boot tự map nó sang server.port, và trước
# đây một giá trị sót lại đã khiến ứng dụng nghe sai cổng, healthcheck hỏng theo.
SHOP_API_HOST_PORT=8080

# Optional. Default: dev. Giá trị: dev | prod
SPRING_PROFILES_ACTIVE=dev


# ----- Postgres -----
POSTGRES_DB=goodminton
POSTGRES_USERNAME=admin
POSTGRES_PASSWORD=change-me


# ----- Redis -----


# ----- RabbitMQ (event-driven sync với rag-service) -----
RABBITMQ_USER=goodminton
RABBITMQ_PASSWORD=change-me

# ----- Internal API key (Spring ↔ rag-service tool calls) -----
# Random UUID hoặc base64 random 
INTERNAL_API_KEY=replace-with-random-uuid


# ----- JWT -----
JWT_SECRET=replace-with-a-strong-base64-secret-min-64-chars
JWT_ACCESS_EXP=600000
JWT_REFRESH_EXP=604800000


# ----- Cloudinary -----
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER_PREFIX=cloud-folder


# ----- PayOS -----
# Signup at https://payos.vn/ -> Merchant dashboard -> API credentials
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
# FE result pages. PayOS redirect browser tới returnUrl (thành công) hoặc cancelUrl (huỷ)
PAYOS_RETURN_URL=https://your-fe-domain.com/payment/result
PAYOS_CANCEL_URL=https://your-fe-domain.com/payment/cancel


# ----- Mail (SMTP Gmail) -----
# Host hardcode trong application.yaml: smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
# App Password 16 ký tự (https://myaccount.google.com/apppasswords)
MAIL_PASSWORD=xxxx xxxx xxxx xxxx


# ----- Frontend -----
FRONTEND_URL=http://localhost:3000


# ----- Super admin (seeded by DataInitializer if no SUPER_ADMIN exists) -----
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONE=0123456789
ADMIN_PASSWORD=ChangeMe@123

# ----- HQ store admin (seeded by DataInitializer if email not present) -----
STORE_ADMIN_EMAIL=hqstore@yourdomain.com
STORE_ADMIN_PHONE=0987654321
STORE_ADMIN_PASSWORD=ChangeMe@456

# ----- Google sign-in -----
# OAuth 2.0 Client ID (loại "Web application") từ Google Cloud Console.
# Backend dùng nó làm "audience" khi kiểm ID token: chữ ký hợp lệ mới chỉ chứng
# minh token do Google phát, còn audience mới chứng minh nó được phát CHO ứng
# dụng này chứ không phải trang khác.
# Để trống thì POST /api/auth/google trả 503 và nút Google không hiện ở frontend.
# KHÔNG cần Client Secret: trình duyệt lấy ID token trực tiếp, không có bước
# đổi authorization code nào ở phía máy chủ.
GOOGLE_CLIENT_ID=
